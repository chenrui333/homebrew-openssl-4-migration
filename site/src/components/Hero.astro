---
import type { Snapshot } from "../lib/types";
import { formatDate, pagePath, pct } from "../lib/format";

interface Props {
  snapshot: Snapshot;
}

const { snapshot } = Astro.props;
const summary = snapshot.summary;
const registryStats = [
  ["Staged", summary.staged_formulae],
  ["Done", summary.done],
  ["Pending", summary.pending],
  ["Open staging PRs", summary.open_staging_prs],
];
---

<section class="hero registry-section">
  <div class="hero__copy">
    <p class="eyebrow"><span></span>Homebrew/homebrew-core migration registry</p>
    <h1>OpenSSL 4 Staging Migration Registry</h1>
    <p class="lede">Human-readable tracker and machine-readable JSON for moving Homebrew formulae from openssl@3 to openssl@4 on the staging branch.</p>
    <div class="hero__meta" aria-label="Snapshot summary">
      <span>Snapshot {formatDate(snapshot.generated_at)}</span>
      <span>Target branch {snapshot.target_branch}</span>
      <span>Current gate {summary.current_gate}</span>
      <span>{pct(summary.done, summary.staged_formulae)} complete</span>
    </div>
    <div class="hero__actions" aria-label="Primary actions">
      <a class="button button--primary" href={pagePath("tracker/")}>Browse tracker</a>
      <a class="button" href={pagePath("queue/")}>View action queue</a>
      <a class="button" href={pagePath("api/snapshot.json")}>Open JSON</a>
    </div>
  </div>
  <aside class="snapshot-card" aria-label="Current migration snapshot">
    <div class="snapshot-card__head">
      <span class="label">Snapshot ledger</span>
      <span>{formatDate(snapshot.generated_at)}</span>
    </div>
    <strong>{summary.current_gate}</strong>
    <p>{summary.current_gate_pending} pending rows in the active staged gate.</p>
    <dl class="snapshot-list">
      <div>
        <dt>Target</dt>
        <dd>{snapshot.target_branch}</dd>
      </div>
      <div>
        <dt>Scope</dt>
        <dd>{snapshot.scope}</dd>
      </div>
      <div>
        <dt>Issue</dt>
        <dd>{snapshot.tracking_issue}</dd>
      </div>
    </dl>
    <div class="hero-stat-grid">
      {registryStats.map(([label, value]) => (
        <div>
          <span>{label}</span>
          <b>{value}</b>
        </div>
      ))}
    </div>
  </aside>
</section>
