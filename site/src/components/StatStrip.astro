---
import type { Snapshot } from "../lib/types";

interface Props {
  snapshot: Snapshot;
}

const { snapshot } = Astro.props;
const summary = snapshot.summary;
const stats = [
  ["Staging-scope formulae", summary.staged_formulae],
  ["Done", summary.done],
  ["Pending", summary.pending],
  ["Open staging PRs", summary.open_staging_prs],
  ["Current gate", summary.current_gate],
  ["Upstream blockers", summary.upstream_blockers],
];
---

<section class="stat-strip" aria-label="Migration statistics">
  {stats.map(([label, value]) => (
    <div class="stat">
      <span>{label}</span>
      <strong>{value}</strong>
    </div>
  ))}
</section>
