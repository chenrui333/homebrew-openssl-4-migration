---
import type { Snapshot } from "../lib/types";

interface Props {
  snapshot: Snapshot;
}

const { snapshot } = Astro.props;
const stats = [
  ["Staging-scope formulae", snapshot.total_formulae],
  ["Done", snapshot.done],
  ["Pending", snapshot.pending],
  ["Open staging PRs", snapshot.open_prs],
  ["Current gate", snapshot.current_gate.label],
  ["Upstream gaps", snapshot.upstream_gap_count],
];
---

<section class="stat-strip" aria-label="Migration statistics">
  {stats.map(([label, value]) => (
    <div class="stat">
      <span>{label}</span>
      <strong>{value}</strong>
    </div>
  ))}
</section>
