---
import type { SnapshotRow } from "../lib/types";
import { depthLabel, formatDate, formulaAnchor, prLabel, slug, upstreamLabel } from "../lib/format";

interface Props {
  rows: SnapshotRow[];
  showControls?: boolean;
  emptyMessage?: string;
}

const { rows, showControls = true, emptyMessage = "No rows match this section." } = Astro.props;
const quickFilters = [
  { filter: "all", label: "All / reset" },
  { filter: "current-gate", label: "Current gate all" },
  { filter: "current-gate-blockers", label: "Current gate blockers" },
  { filter: "pending", label: "Pending" },
  { filter: "ready", label: "Ready" },
  { filter: "draft", label: "Draft" },
  { filter: "ci-blocked", label: "CI blocked" },
  { filter: "retarget", label: "Retarget" },
  { filter: "missing-pr", label: "Missing PR" },
  { filter: "upstream-blocked", label: "Upstream blocked" },
  { filter: "done", label: "Done" },
];
---

{showControls && (
  <section class="registry-controls" data-registry-controls>
    <label>
      <span>Search registry</span>
      <input type="search" data-registry-search placeholder="Formula, upstream repo, PR number, gate, action" />
    </label>
    <div class="filter-chips" aria-label="Registry filters">
      {quickFilters.map(({ filter, label }) => (
        <button type="button" data-filter={filter} data-filter-label={label} aria-pressed={filter === "all" ? "true" : "false"}>{label}</button>
      ))}
    </div>
    <div class="filter-summary">
      <p data-result-count class="figure-caption"></p>
      <p data-active-filter class="figure-caption">Active filter: All / reset</p>
      <button type="button" class="filter-clear" data-filter-clear hidden>Clear</button>
    </div>
  </section>
)}

{rows.length === 0 ? (
  <div class="empty-state">
    <strong>{emptyMessage}</strong>
  </div>
) : (
<div class="registry-table" data-registry-table>
  <table>
    <thead>
      <tr>
        <th><button type="button" class="sort-button" data-sort="name">Formula</button></th>
        <th><button type="button" class="sort-button" data-sort="action">Action</button></th>
        <th aria-sort="descending"><button type="button" class="sort-button" data-sort="impact" data-sort-active="true">Impact</button></th>
        <th><button type="button" class="sort-button" data-sort="gate">Gate</button></th>
        <th><button type="button" class="sort-button" data-sort="status">Status</button></th>
        <th>PR</th>
        <th>Evidence</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr
          id={formulaAnchor(row)}
          data-row
          data-name={row.name.toLowerCase()}
          data-filter-text={(row.name + " " + upstreamLabel(row) + " " + row.target_branch + " " + prLabel(row) + " " + row.next_action + " " + row.readiness.join(" ") + " " + row.group_label).toLowerCase()}
          data-current-gate={row.flags.current_gate}
          data-status={row.live_status.toLowerCase()}
          data-readiness={row.readiness.join(" ")}
          data-action={slug(row.next_action)}
          data-gate={row.group_label.toLowerCase()}
          data-gate-filter={slug(row.group_label)}
          data-impact={row.impact_count}
          data-target={row.target_branch}
          data-ready={row.flags.ready}
          data-draft={row.flags.draft}
          data-ci-blocked={row.flags.ci_blocked}
          data-base-mismatch={row.flags.base_mismatch}
          data-missing-pr={row.flags.missing_pr}
          data-upstream-blocked={row.flags.upstream_blocked}
          data-pr={row.pr.number > 0}
          data-has-issue={row.issues.length > 0}
          data-coverage-gap={row.issues.some((issue) => issue.label === "search")}
        >
          <td data-label="Formula">
            <strong>{row.name}</strong>
            <span>{depthLabel(row)} · {row.group_label}</span>
          </td>
          <td data-label="Action">
            <span class={"pill action-" + slug(row.next_action)}>{row.next_action}</span>
            {row.readiness.length > 0 && <span class="readiness-mini">{row.readiness.join(" · ")}</span>}
          </td>
          <td data-label="Impact"><span class="impact">{row.impact_count}</span></td>
          <td data-label="Gate">{row.group_label}</td>
          <td data-label="Status">{row.live_status}</td>
          <td data-label="PR">
            {row.pr.url ? <a href={row.pr.url}>{prLabel(row)}</a> : prLabel(row)}
            {row.pr.updated_at && <span class="pr-updated">updated {formatDate(row.pr.updated_at)}</span>}
          </td>
          <td data-label="Evidence" class="evidence-cell">
            <div class="evidence-line">
              <span class="evidence-label">Upstream</span>
              {row.upstream.url ? <a href={row.upstream.url}>{upstreamLabel(row)}</a> : <span>{upstreamLabel(row)}</span>}
            </div>
            <div class="evidence-line">
              <span class="evidence-label">Issues</span>
              {row.issues.length === 0 ? (
                <span class="muted">none</span>
              ) : (
                <span class="issue-list">
                  {row.issues.slice(0, 2).map((issue, index) => (
                    <>
                      {index > 0 && ", "}
                      <a href={issue.url}>{issue.label}</a>
                    </>
                  ))}
                </span>
              )}
            </div>
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
)}
