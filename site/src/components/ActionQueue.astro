---
import type { SnapshotRow } from "../lib/types";
import { queueActions, rowsForAction } from "../lib/data";
import { pagePath, prLabel, trackerHref } from "../lib/format";
import ActionBadge from "./ActionBadge.astro";
import ImpactBadge from "./ImpactBadge.astro";

const buckets = queueActions.map((action) => {
  const totalRows = rowsForAction(action) as SnapshotRow[];
  return {
    action,
    rows: totalRows.slice(0, 4),
    total: totalRows.length,
  };
});
const activeBuckets = buckets.filter((bucket) => bucket.total > 0);
const emptyBuckets = buckets.filter((bucket) => bucket.total === 0);
---

<section id="action-queue" class="registry-section">
  <div class="section-heading">
    <span>§ 02</span>
    <div>
      <h2>Action queue</h2>
      <p>Daily maintainer buckets derived from readiness state.</p>
    </div>
  </div>
  {activeBuckets.length === 0 ? (
    <div class="empty-state">
      <strong>No rows currently need action.</strong>
      <p>All maintainer action buckets are clear in the current snapshot.</p>
    </div>
  ) : (
    <div class="queue-grid">
      {activeBuckets.map(({ action, rows, total }) => (
        <article class="queue-card">
          <div class="queue-card__head">
            <ActionBadge action={action} />
            <strong>{total}</strong>
          </div>
          <ol>
            {rows.map((row) => (
              <li>
                <div class="queue-card__item">
                  <a href={trackerHref(row)}>
                    <span>{row.name}</span>
                    <small>{prLabel(row)} · {row.group_label}</small>
                  </a>
                  <span class="queue-card__links">
                    {row.pr.url && <a href={row.pr.url}>PR</a>}
                    {row.upstream.url && <a href={row.upstream.url}>Upstream</a>}
                    {row.issues.slice(0, 1).map((issue) => <a href={issue.url}>Issue</a>)}
                  </span>
                </div>
                <ImpactBadge value={row.impact_count} />
              </li>
            ))}
          </ol>
          <a class="queue-card__more" href={pagePath("queue/")}>View {total} rows</a>
        </article>
      ))}
    </div>
  )}
  {emptyBuckets.length > 0 && (
    <p class="queue-clear-buckets">
      <strong>Clear buckets</strong>
      {emptyBuckets.map((bucket, index) => (
        <>
          {index === 0 ? " " : ", "}
          <span>{bucket.action}</span>
        </>
      ))}
    </p>
  )}
  <p class="figure-caption">Open the queue page for complete sections and links.</p>
</section>
