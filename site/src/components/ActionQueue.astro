---
import type { SnapshotRow } from "../lib/types";
import { rowsForAction } from "../lib/data";
import { pagePath, prLabel, slug } from "../lib/format";

const actions = [
  "Review and merge",
  "Retarget to staging",
  "Inspect CI",
  "Resolve draft blockers",
  "Track upstream blocker",
  "Open migration PR",
];
---

<section class="registry-section">
  <div class="section-heading">
    <span>§ 02</span>
    <div>
      <h2>Action queue</h2>
      <p>Daily maintainer buckets derived from readiness state.</p>
    </div>
  </div>
  <div class="queue-grid">
    {actions.map((action) => {
      const rows = rowsForAction(action, 4) as SnapshotRow[];
      const total = rowsForAction(action).length;
      return (
        <article class="queue-card">
          <div class="queue-card__head">
            <span class={"pill action-" + slug(action)}>{action}</span>
            <strong>{total}</strong>
          </div>
          <ol>
            {rows.map((row) => (
              <li>
                <a href={row.open_pr_url || row.upstream_url || pagePath("tracker/")}>
                  <span>{row.name}</span>
                  <small>{prLabel(row)} · {row.target_branch}</small>
                </a>
                <b>{row.impact_count}</b>
              </li>
            ))}
          </ol>
          <a class="queue-card__more" href={pagePath("queue/")}>View {total} rows</a>
        </article>
      );
    })}
  </div>
  <p class="figure-caption">Open the queue page for complete sections and links.</p>
</section>
