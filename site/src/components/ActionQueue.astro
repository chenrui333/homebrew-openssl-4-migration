---
import type { SnapshotRow } from "../lib/types";
import { queueActions, rowsForAction } from "../lib/data";
import { pagePath, prLabel, slug, trackerHref } from "../lib/format";
import ImpactBadge from "./ImpactBadge.astro";
---

<section id="action-queue" class="registry-section">
  <div class="section-heading">
    <span>§ 02</span>
    <div>
      <h2>Action queue</h2>
      <p>Daily maintainer buckets derived from readiness state.</p>
    </div>
  </div>
  <div class="queue-grid">
    {queueActions.map((action) => {
      const rows = rowsForAction(action, 4) as SnapshotRow[];
      const total = rowsForAction(action).length;
      return (
        <article class="queue-card">
          <div class="queue-card__head">
            <span class={"pill action-" + slug(action)}>{action}</span>
            <strong>{total}</strong>
          </div>
          <ol>
            {rows.length === 0 ? (
              <li class="queue-empty">No rows currently need this action.</li>
            ) : rows.map((row) => (
              <li>
                <div class="queue-card__item">
                  <a href={trackerHref(row)}>
                    <span>{row.name}</span>
                    <small>{prLabel(row)} · {row.group_label}</small>
                  </a>
                  <span class="queue-card__links">
                    {row.pr.url && <a href={row.pr.url}>PR</a>}
                    {row.upstream.url && <a href={row.upstream.url}>Upstream</a>}
                    {row.issues.slice(0, 1).map((issue) => <a href={issue.url}>Issue</a>)}
                  </span>
                </div>
                <ImpactBadge value={row.impact_count} />
              </li>
            ))}
          </ol>
          <a class="queue-card__more" href={pagePath("queue/")}>View {total} rows</a>
        </article>
      );
    })}
  </div>
  <p class="figure-caption">Open the queue page for complete sections and links.</p>
</section>
