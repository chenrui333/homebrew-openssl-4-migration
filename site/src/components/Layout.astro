---
import "../styles/global.css";
import { snapshot } from "../lib/data";
import { basePath, formatDate, pagePath } from "../lib/format";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "OpenSSL 4 Staging Migration Registry",
  description = "A dated, inspectable staging-branch registry for moving Homebrew formulae from openssl@3 to openssl@4 on openssl-4-migration-staging.",
} = Astro.props;
const currentPath = Astro.url.pathname.replace(basePath, "/");
const summary = snapshot.summary;
const gitSha = String(import.meta.env.PUBLIC_GIT_SHA || "").slice(0, 7);
const buildLabel = gitSha || "local";
const navItems = [
  { label: "Overview", href: pagePath(), match: "/" },
  { label: "Queue", href: pagePath("queue/"), match: "/queue/" },
  { label: "Tracker", href: pagePath("tracker/"), match: "/tracker/" },
  { label: "Upstream", href: pagePath("upstream/"), match: "/upstream/" },
  { label: "JSON", href: pagePath("api/snapshot.json"), match: "/api/snapshot.json" },
];

function isActive(match: string) {
  if (match === "/") return currentPath === "/" || currentPath === "";
  return currentPath.startsWith(match);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="topbar">
      <nav class="topbar__inner" aria-label="Primary navigation">
        <a class="brand" href={pagePath()}>
          <span class="brand__mark">SSL4</span>
          <span>Migration Registry</span>
          <em>Staging status ledger</em>
        </a>
        <div class="navlinks">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.match) ? "page" : undefined}>{item.label}</a>
          ))}
        </div>
      </nav>
      <div class="snapshot-bar" aria-label="Current staging snapshot">
        <span>{summary.current_gate}</span>
        <span>{summary.current_gate_pending} pending</span>
        <span>{summary.open_staging_prs} open staging PRs</span>
        <span>snapshot {formatDate(snapshot.generated_at)}</span>
        <span>site build {buildLabel}</span>
      </div>
    </header>
    <main id="content">
      <slot />
    </main>
    <script src={pagePath("registry-table.js")} defer></script>
  </body>
</html>
