---
import Layout from "../components/Layout.astro";
import Hero from "../components/Hero.astro";
import StatStrip from "../components/StatStrip.astro";
import FrontierRows from "../components/FrontierRows.astro";
import ActionQueue from "../components/ActionQueue.astro";
import TrustLayer from "../components/TrustLayer.astro";
import WorkflowRail from "../components/WorkflowRail.astro";
import Footer from "../components/Footer.astro";
import { snapshot, currentGateRows } from "../lib/data";
import { pagePath } from "../lib/format";

const railItems = [
  { label: "Current frontier", href: "#current-frontier", count: snapshot.summary.current_gate_pending },
  { label: "Action queue", href: "#action-queue", count: snapshot.summary.pending },
  { label: "Methodology", href: "#methodology" },
  { label: "JSON snapshot", href: "#json-snapshot" },
];
---

<Layout>
  <div class="workflow-shell">
    <WorkflowRail title="Overview workflow" items={railItems} />
    <div class="workflow-content">
      <Hero snapshot={snapshot} />
      <StatStrip snapshot={snapshot} />
      <FrontierRows rows={currentGateRows(6)} />
      <ActionQueue />
      <TrustLayer />
      <section id="json-snapshot" class="registry-section data-section">
        <div class="section-heading">
          <span>§ 04</span>
          <div>
            <h2>Open JSON snapshot</h2>
            <p>Astro renders the public staging-branch site from the normalized dataset generated by the Go harness.</p>
          </div>
        </div>
        <pre><code>curl -L https://chenrui333.github.io/homebrew-openssl-4-migration/api/snapshot.json</code></pre>
        <a class="button" href={pagePath("api/snapshot.json")}>Open snapshot JSON</a>
      </section>
      <Footer />
      </div>
  </div>
</Layout>
